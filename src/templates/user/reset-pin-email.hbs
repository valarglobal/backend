<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Verify Your Identity - Wallet PIN Reset</title>
    <style>
     .body {
      margin: 0;
      padding: 10px;
      font-family: Arial, sans-serif;
      background-color: white;
      color: #000000;
    }

    /* Wrapper to
      center content */
    .wrapper {
      background-color: white;
      padding: 15px;
    }

    /*
      Email container */
    .container {
      background-color: transparent;
      width: 100%;
      max-width: 600px;
      border-collapse: collapse;
      /*
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); */
    }

    /* Header styles */
    .email-header {
      background-color: rgb(233, 233, 233);
      text-align: center;
      padding: 8px;
    }

    .email-header p {
      font-size: 24px;
      font-weight: 600;
    }

    .email-header h1 {
      color: #ffffff;
      font-size: 24px;
      margin: 0;
    }

    /*
      Content styles */
    .email-content {
      padding: 20px;
      color: black;
      font-size: 16px;
      line-height: 1.6;
    }

    .email-content h2 {
      margin: 0 0 15px;
      font-size: 13px;
      color: black;
      font-weight: 300;
    }

    .responsive-img {
      width: 100%;
      height: auto;
    }

    .email-content a {
      color: #F76301,
      text-decoration: none;
    }

    /* Footer styles */
    .email-footer {
      /* background-color: #f1f1f1; */
      background-color: transparent;
      text-align: center;
      padding: 10px;
      font-size: 12px;
      color: rgb(108, 108, 108);
    }

    .email-footer a {
      color: #F76301;
      text-decoration: none;
    }

    .footer {
      text-align: center;
      color: #999999;
      padding: 20px 0;
      font-size: 12px;
    }
    </style>
  </head>
  <body>

    <div class='-wrapper"'>
    <table class='container'>
      <!-- Content Section -->
      <tr>
        <td class='email-content'>
          <img src='https://res.cloudinary.com/dfqu9xh4w/image/upload/v1756485815/verify_your_transaction_pin-2_2_ykmfwm.jpg' alt='img'
            class='responsive-img' />
          <br />
          <br />
          <h2>Dear  {{firstName}},</h2>
          <p>
       We received a request to reset your wallet PIN. To verify your identity
        and proceed with resetting your PIN, please use the one-time password
  
          </p>
          <p>
           <strong class='otp'>OTP Code: {{otpCode}}</strong><br /><br />
        This code is valid for 10 minutes. If you did not request this change,
        please ignore this email or contact our support team immediately.
          </p>
          <p>
            Please, if you did not initiate this action, contact our customer
            support at
            <a href='mailto:Support@valarpay.com'>Support@valarpay.com</a>
            or call
            <strong>8134146906</strong>
            as your account might have been compromised.
          </p>
          <p>Kind Regards,<br />Valarpay Team</p>
        </td>
      </tr>

      <!-- Footer Section -->
      <tr>
        <td class='email-footer'>
          If you experience any problems, kindly contact us at
          <a href='mailto:Support@valarpay.com'>Support@valarpay.com</a>
          or send us a WhatsApp message at
          <a href='tel:+234-813-414-6906'>+234 813 414 6906</a>.
        </td>
      </tr>
      <tr>
        <td class='footer'>
          <p> Valarpay. All Rights Reserved.</p>
        </td>
      </tr>
    </table>
  </div>
    
  </body>
</html>