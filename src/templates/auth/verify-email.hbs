<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta http-equiv='X-UA-Compatible' content='ie=edge' />
    <title>OTP Verification</title>
    <style>
      /* Reset some default styles */ body, html { margin: 0; padding: 0;
      font-family: Arial, sans-serif; height: 100%; width: 100%;
      background-color: #f4f4f9; } /* Container for the email content */
      .email-container { width: 100%; max-width: 600px; margin: 0 auto; padding:
      20px; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 8px
      rgba(0, 0, 0, 0.1); } /* Header Section */ .email-header { text-align:
      center; padding-bottom: 20px; } .email-header h1 { color: #f57c00; /*
      Orange */ font-size: 36px; margin: 0; } .email-header p { font-size: 18px;
      color: #333; } /* Main Content Section */ .email-body { font-size: 16px;
      line-height: 1.6; color: #333; padding: 20px 0; } .email-body h2 { color:
      #f57c00; /* Orange */ font-size: 24px; } .email-body p { margin: 10px 0; }
      .email-body a { color: #f57c00; /* Orange */ text-decoration: none;
      font-weight: bold; } /* Footer Section */ .email-footer { text-align:
      center; padding-top: 20px; font-size: 14px; color: #888; } .email-footer p
      { margin: 5px 0; } .email-footer a { color: #f57c00; /* Orange */
      text-decoration: none; } .btn { background-color: #f57c00; /* Orange */
      color: #ffffff; padding: 10px 20px; text-align: center; border-radius:
      5px; text-decoration: none; display: inline-block; font-weight: bold;
      margin-top: 20px; } .btn:hover { background-color: #e65100; }
    </style>
  </head>
  <body>
    <div class='email-container'>
      <!-- Header -->
      <div class='email-header'>
        <h1>OTP Verification</h1>
        <p>Your verification code</p>
      </div>

      <!-- Body -->
      <div class='email-body'>
        <h2>Here is your OTP code:</h2>
        <p
          style='font-size: 32px; font-weight: bold; color: #f57c00;'
        >{{otpCode}}</p>
        <p>This code will expire in 10 minutes.</p>
        <p>If you didn't request this OTP, please ignore this email.</p>
        <p>If you need any assistance, feel free to
          <a href='mailto:support@example.com'>contact us</a>.</p>
      </div>

      <!-- Footer -->
      <div class='email-footer'>
        <p>&copy; 2024 Our Company. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>